{
  "type": "module",
  "main": "dist/build.js",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "build-docs": "node .",
    "minify-docs": "html-minifier-next -I output -O output",
    "pack-docs": "node dist/pack.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "html-minifier-next": "^8.1.0",
    "tar-xz": "^6.1.1"
  }
}
